# ─────────────────────────────────────────────────────────────────────
# Vetra Backend Core — Environment Variable Placeholders
# ─────────────────────────────────────────────────────────────────────

# Application Execution Server Port & Active Profile
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL 17 + PostGIS Database Credentials
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vetra_db
DB_USER=vetra_user
DB_PASSWORD=vetra_password_secret

# Security & JWT Credentials (Secret must be minimum 256-bit / 32 characters)
JWT_SECRET=replace_with_a_secure_256_bit_random_secret_string
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Security Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# AWS S3 Cloud Storage & Region Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=vetra-production-media-storage

# AI Diagnostic Engine Configuration
AI_ENABLED=true
AI_DEFAULT_PROVIDER=GEMINI
GEMINI_API_KEY=

# Firebase Cloud Messaging (FCM) Push Provider Credentials
FCM_PROJECT_ID=vetra-firebase-project-id
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
FCM_CLIENT_EMAIL=firebase-adminsdk@vetra-app.iam.gserviceaccount.com

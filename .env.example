# ─────────────────────────────────────────────────────────────────────────────
# VETRA Backend Core — Production Environment Configuration (.env)
# Deploy Target: Azure Ubuntu Virtual Machine (Docker Compose)
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. Application Server & Runtime ─────────────────────────────────────────
PORT=8080
SPRING_PROFILES_ACTIVE=prod
MANAGEMENT_PORT=8080

# ─── 2. PostgreSQL 17 + PostGIS Database (Internal Docker Service) ───────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vetra_db
DB_USER=vetra_user
DB_PASSWORD=vetra_secure_password_replace_in_production

# ─── 3. Redis 7 Cache Engine (Internal Docker Service) ───────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=vetra_redis_password_replace_in_production
REDIS_DATABASE=0
REDIS_TIMEOUT=2000ms
REDIS_SSL=false

# ─── 4. Security & JWT Credentials ───────────────────────────────────────────
# Must be a cryptographically secure 256-bit (32+ character) string
JWT_SECRET=replace_with_a_secure_256_bit_random_secret_string_minimum_32_chars
JWT_EXPIRATION_MS=86400000          # 24 Hours
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 Days

# ─── 5. CORS Security Configuration ──────────────────────────────────────────
# Comma-separated list of allowed web origins or '*' for open mobile access
CORS_ALLOWED_ORIGINS=*

# ─── 6. Google Gemini AI Diagnostics ─────────────────────────────────────────
AI_ENABLED=true
AI_DEFAULT_PROVIDER=gemini
GEMINI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT=30s
GEMINI_MAX_RETRIES=3

# ─── 7. Firebase Cloud Messaging (FCM Push Alerts) ───────────────────────────
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=vetra-1ebfa
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── 8. Storage Configuration (Optional Cloud / Fallback) ────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=vetra-media-storage

# ─── 9. Observability & Tracing ──────────────────────────────────────────────
OTEL_SERVICE_NAME=vetra-backend
OTEL_SERVICE_NAMESPACE=vetra
OTEL_SERVICE_VERSION=1.0.0
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0

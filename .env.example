# ─────────────────────────────────────────────────────────────────────
# Vetra Backend — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────

# ─── Spring Profile ───────────────────────────────────────────────────
SPRING_PROFILE=dev

# ─── Server ──────────────────────────────────────────────────────────
SERVER_PORT=8080
MANAGEMENT_PORT=8080

# ─── Database ────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/vetra_dev
DB_USERNAME=vetra
DB_PASSWORD=change_me

# ─── JWT ─────────────────────────────────────────────────────────────
# Generate a 256-bit (32+ char) random secret. Never reuse across envs.
JWT_SECRET=REPLACE_WITH_MINIMUM_256_BIT_RANDOM_SECRET_VALUE_HERE
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── CORS ────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── AWS S3 ──────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=vetra-media
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_AWS_SECRET_KEY
AWS_S3_URL_EXPIRY=15

# ─── PostgreSQL (used by Docker Compose only) ────────────────────────
POSTGRES_DB=vetra_dev
POSTGRES_USER=vetra
POSTGRES_PASSWORD=change_me

# ─── AI Diagnostic Platform & Gemini Vision ──────────────────────────
AI_ENABLED=true
AI_DEFAULT_PROVIDER=GEMINI
GEMINI_ENABLED=true
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.4.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "JVM heap, non-heap, garbage collection, CPU, threads, and class loading metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "minVizHeight": 75, "minVizWidth": 75, "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "title": "Heap Usage %",
      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
          "expr": "sum(jvm_memory_used_bytes{application=\"vetra-backend\",area=\"heap\"}) / sum(jvm_memory_max_bytes{application=\"vetra-backend\",area=\"heap\"})",
          "legendFormat": "heap %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 0.8 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "CPU Usage (Process)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
          "expr": "process_cpu_usage{application=\"vetra-backend\"}",
          "legendFormat": "process cpu",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 200 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Live Threads",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
          "expr": "jvm_threads_live_threads{application=\"vetra-backend\"}",
          "legendFormat": "live threads",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Loaded Classes",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
          "expr": "jvm_classes_loaded_classes{application=\"vetra-backend\"}",
          "legendFormat": "loaded classes",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": { "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "JVM Memory — Heap Used vs Committed vs Max",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
          "expr": "sum(jvm_memory_used_bytes{application=\"vetra-backend\",area=\"heap\"})",
          "legendFormat": "heap used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
          "expr": "sum(jvm_memory_committed_bytes{application=\"vetra-backend\",area=\"heap\"})",
          "legendFormat": "heap committed",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
          "expr": "sum(jvm_memory_max_bytes{application=\"vetra-backend\",area=\"heap\"})",
          "legendFormat": "heap max",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": { "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "JVM Memory — Non-Heap Used vs Committed",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
          "expr": "sum(jvm_memory_used_bytes{application=\"vetra-backend\",area=\"nonheap\"})",
          "legendFormat": "non-heap used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
          "expr": "sum(jvm_memory_committed_bytes{application=\"vetra-backend\",area=\"nonheap\"})",
          "legendFormat": "non-heap committed",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "options": { "legend": { "calcs": ["mean", "max", "sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "GC Pause Duration (by Cause)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
          "expr": "sum by (cause) (rate(jvm_gc_pause_seconds_sum{application=\"vetra-backend\"}[$__rate_interval]))",
          "legendFormat": "{{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "options": { "legend": { "calcs": ["mean", "last"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Thread States",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vetra-prometheus" },
          "expr": "jvm_threads_states_threads{application=\"vetra-backend\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["vetra", "jvm", "memory", "gc"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Vetra — JVM Internals",
  "uid": "vetra-jvm",
  "version": 1
}

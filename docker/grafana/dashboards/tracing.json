{
  "__inputs": [],
  "__elements": {},
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.4.0"},
    {"type": "datasource", "id": "tempo", "name": "Tempo", "version": "1.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "table", "name": "Table", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "nodeGraph", "name": "Node Graph", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "Vetra Distributed Traces — Stage 12.5.0. End-to-end request visibility via OpenTelemetry and Grafana Tempo.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "tags": ["vetra"],
      "title": "Vetra Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Service Overview",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
      "description": "Total HTTP requests per second across all endpoints.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 500}
            ]
          },
          "unit": "reqps"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Request Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"vetra-backend\"}[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
      "description": "P95 HTTP request latency across all endpoints.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.2},
              {"color": "red", "value": 1.0}
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "P95 Latency",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"vetra-backend\"}[5m])))",
          "legendFormat": "P95",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
      "description": "HTTP 5xx error rate in the last 5 minutes.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Error Rate (5xx)",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"vetra-backend\",outcome=\"SERVER_ERROR\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"vetra-backend\"}[5m]))",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
      "description": "Active JVM threads.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "blue", "value": null}]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "JVM Threads",
      "type": "stat",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
          "expr": "jvm_threads_live_threads{application=\"vetra-backend\"}",
          "legendFormat": "live threads",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "title": "Request Latency by Endpoint",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
      "description": "P50, P95, P99 latency per HTTP endpoint. Exemplars link to specific traces in Tempo — click orange dots.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "s"
        }
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 6},
      "id": 10,
      "options": {
        "legend": {"calcs": ["mean", "max", "p95"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "title": "HTTP Latency by Endpoint (P50 / P95 / P99)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
          "expr": "histogram_quantile(0.50, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"vetra-backend\"}[$__rate_interval])))",
          "legendFormat": "P50 {{uri}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"vetra-backend\"}[$__rate_interval])))",
          "legendFormat": "P95 {{uri}}",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"vetra-backend\"}[$__rate_interval])))",
          "legendFormat": "P99 {{uri}}",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 102,
      "title": "Trace Search",
      "type": "row"
    },
    {
      "datasource": {"type": "tempo", "uid": "vetra-tempo"},
      "description": "Live trace search against Grafana Tempo. Filter by service, status, duration, and span attributes. Click a trace ID to open the full trace waterfall.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": true, "inspect": false},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Duration"},
            "properties": [{"id": "unit", "value": "ns"}, {"id": "custom.width", "value": 100}]
          },
          {
            "matcher": {"id": "byName", "options": "Start time"},
            "properties": [{"id": "custom.width", "value": 180}]
          },
          {
            "matcher": {"id": "byName", "options": "Trace ID"},
            "properties": [{"id": "custom.width", "value": 280}]
          }
        ]
      },
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 15},
      "id": 20,
      "options": {
        "footer": {"countRows": false, "enablePagination": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Start time"}]
      },
      "title": "Trace Explorer",
      "type": "table",
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "vetra-tempo"},
          "filters": [{"id": "service-name", "operator": "=", "scope": "resource", "tag": "service.name", "value": ["vetra-backend"], "valueType": "string"}],
          "limit": 20,
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces",
          "query": "{resource.service.name=\"vetra-backend\"}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25},
      "id": 103,
      "title": "Request Rate by Endpoint",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
      "description": "HTTP request throughput per endpoint. Low-cardinality URI labels only — Spring MVC template patterns, not parameterized values.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "reqps"
        }
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 26},
      "id": 30,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "title": "Request Rate by Endpoint",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "vetra-prometheus"},
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{application=\"vetra-backend\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34},
      "id": 104,
      "title": "Error Traces",
      "type": "row"
    },
    {
      "datasource": {"type": "tempo", "uid": "vetra-tempo"},
      "description": "Traces where the root span status is ERROR. These correspond to failed requests and span.error() events recorded by the GlobalExceptionHandler.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "red"},
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": true, "inspect": false},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}]}
        }
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 35},
      "id": 40,
      "options": {
        "footer": {"show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Start time"}]
      },
      "title": "Error Traces",
      "type": "table",
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "vetra-tempo"},
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces",
          "query": "{resource.service.name=\"vetra-backend\" && status=error}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["vetra", "tracing", "tempo", "opentelemetry"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Vetra — Distributed Traces",
  "uid": "vetra-tracing",
  "version": 1
}
